FLASK_ENV=development
SECRET_KEY=              # generate with: python -c "import secrets; print(secrets.token_hex(32))"
MONGO_URI=               # e.g. mongodb://localhost:27017/ or MongoDB Atlas URI
DATABASE_NAME=agropulse
CORS_ORIGINS=            # comma-separated allowed origins e.g. http://localhost:5000
REDIS_URL=               # e.g. redis://localhost:6379/0 or leave empty for memory://
BASE_URL=                # public URL e.g. http://localhost:5000
LOG_LEVEL=INFO
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=           # sender email
MAIL_PASSWORD=           # app password
MAIL_DEFAULT_SENDER=     # display name and address
